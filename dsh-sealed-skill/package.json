{
  "name": "@yourco/dsh-skill-sealed",
  "version": "0.1.0",
  "private": true,
  "description": "Serve product skills from an encrypted pack: no plaintext SKILL.md, opaque resource base, in-memory script execution.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/core.js",
    "lib/pack.js",
    "lib/runner.js",
    "cordis.patch.yml",
    "assets/*.pack",
    "assets/*.key"
  ],
  "scripts": {
    "seal": "node bin/seal.mjs",
    "test": "node test/smoke.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
